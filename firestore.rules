rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipPath(organizationId, userId) {
      return /databases/$(database)/documents/organizations/$(organizationId)/memberships/$(userId);
    }

    function isActiveMember(organizationId) {
      return signedIn()
        && exists(membershipPath(organizationId, request.auth.uid))
        && get(membershipPath(organizationId, request.auth.uid)).data.userId == request.auth.uid
        && get(membershipPath(organizationId, request.auth.uid)).data.organizationId == organizationId
        && get(membershipPath(organizationId, request.auth.uid)).data.status == 'active';
    }

    function isTeacher(organizationId) {
      return isActiveMember(organizationId)
        && get(membershipPath(organizationId, request.auth.uid)).data.role == 'teacher';
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function teamMemberPath(teamId, userId) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(userId);
    }

    function routePath(routeId) {
      return /databases/$(database)/documents/routes/$(routeId);
    }

    function draftPath(routeId, draftId) {
      return /databases/$(database)/documents/routes/$(routeId)/drafts/$(draftId);
    }

    function isTeamManager(teamId) {
      return signedIn()
        && exists(teamMemberPath(teamId, request.auth.uid))
        && get(teamMemberPath(teamId, request.auth.uid)).data.status == 'active'
        && get(teamMemberPath(teamId, request.auth.uid)).data.roles.hasAny(['manager']);
    }

    function canManageTeam(teamId, organizationId) {
      return isActiveMember(organizationId)
        && (
          isTeacher(organizationId)
          || get(teamPath(teamId)).data.createdByUserId == request.auth.uid
          || isTeamManager(teamId)
        );
    }

    function canManageTeamAfterWrite(teamId, organizationId) {
      return isActiveMember(organizationId)
        && (
          isTeacher(organizationId)
          || getAfter(teamPath(teamId)).data.createdByUserId == request.auth.uid
          || isTeamManager(teamId)
        );
    }

    function validTeam(teamId) {
      return request.resource.data.keys().hasOnly([
          'id', 'organizationId', 'name', 'createdByUserId', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == teamId
        && request.resource.data.organizationId is string
        && request.resource.data.name is string
        && request.resource.data.createdByUserId is string
        && request.resource.data.status in ['active', 'archived']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validTeamMember(teamId, userId) {
      return request.resource.data.keys().hasOnly([
          'id', 'teamId', 'userId', 'roles', 'status', 'joinedAt'
        ])
        && request.resource.data.id == teamId + '_' + userId
        && request.resource.data.teamId == teamId
        && request.resource.data.userId == userId
        && request.resource.data.roles is list
        && request.resource.data.roles.hasOnly([
          'manager', 'researcher', 'writer', 'photographer', 'station_designer',
          'question_designer', 'route_planner'
        ])
        && request.resource.data.status in ['active', 'removed']
        && request.resource.data.joinedAt is timestamp;
    }

    function canManageRoute(route) {
      return isActiveMember(route.organizationId)
        && exists(teamPath(route.ownerTeamId))
        && get(teamPath(route.ownerTeamId)).data.organizationId == route.organizationId
        && canManageTeam(route.ownerTeamId, route.organizationId);
    }

    function validRoute(routeId) {
      return request.resource.data.keys().hasAll([
          'id', 'organizationId', 'ownerTeamId', 'createdByUserId', 'title', 'status',
          'currentDraftId', 'visibility', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'organizationId', 'ownerTeamId', 'createdByUserId', 'title', 'status',
          'currentDraftId', 'latestSubmittedVersionId', 'approvedVersionId', 'visibility',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == routeId
        && request.resource.data.organizationId is string
        && request.resource.data.ownerTeamId is string
        && request.resource.data.createdByUserId is string
        && request.resource.data.title is string
        && request.resource.data.currentDraftId is string
        && request.resource.data.currentDraftId.size() > 0
        && request.resource.data.status in ['draft', 'in_review', 'changes_requested', 'approved', 'archived']
        && request.resource.data.visibility in ['private', 'class', 'school']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validDraft(routeId, draftId, route) {
      return request.resource.data.keys().hasAll([
          'id', 'routeId', 'organizationId', 'ownerTeamId', 'content',
          'updatedByUserId', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'routeId', 'organizationId', 'ownerTeamId', 'basedOnVersionId',
          'content', 'updatedByUserId', 'updatedAt'
        ])
        && request.resource.data.id == draftId
        && request.resource.data.routeId == routeId
        && request.resource.data.organizationId == route.organizationId
        && request.resource.data.ownerTeamId == route.ownerTeamId
        && request.resource.data.updatedByUserId == request.auth.uid
        && request.resource.data.content is map
        && request.resource.data.updatedAt is timestamp
        && route.currentDraftId == draftId;
    }

    function validDraftStation(routeId, draftId, stationId) {
      return request.resource.data.keys().hasAll([
          'id', 'routeId', 'draftId', 'title', 'shortLabel', 'description', 'position',
          'stationType', 'contentBlocks', 'trigger', 'tasks', 'estimatedTimeMinutes',
          'required', 'allowSkip', 'allowRevisit'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'routeId', 'draftId', 'title', 'shortLabel', 'description', 'instructions',
          'position', 'stationType', 'contentBlocks', 'trigger', 'tasks',
          'estimatedTimeMinutes', 'required', 'allowSkip', 'allowRevisit', 'safetyNote',
          'accessibilityAlternative', 'locationData'
        ])
        && request.resource.data.id == stationId
        && request.resource.data.routeId == routeId
        && request.resource.data.draftId == draftId
        && request.resource.data.title is string
        && request.resource.data.position is int
        && request.resource.data.contentBlocks is list
        && request.resource.data.trigger is map
        && request.resource.data.tasks is list;
    }

    function canWriteDraft(routeId, draftId) {
      let route = getAfter(routePath(routeId)).data;
      return canManageRoute(route)
        && route.currentDraftId == draftId;
    }

    match /organizations/{organizationId} {
      allow read: if isActiveMember(organizationId);
      allow write: if false;

      match /memberships/{userId} {
        allow get: if signedIn() && (
          request.auth.uid == userId || isTeacher(organizationId)
        );
        allow list: if isTeacher(organizationId);
        allow write: if false;
      }
    }

    match /teams/{teamId} {
      allow read: if isActiveMember(resource.data.organizationId);
      allow create: if validTeam(teamId)
        && isActiveMember(request.resource.data.organizationId)
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if validTeam(teamId)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.createdByUserId == resource.data.createdByUserId
        && request.resource.data.createdAt == resource.data.createdAt
        && canManageTeam(teamId, resource.data.organizationId);
      allow delete: if isTeacher(resource.data.organizationId);

      match /members/{userId} {
        allow read: if isActiveMember(get(teamPath(teamId)).data.organizationId);
        allow create: if validTeamMember(teamId, userId)
          && request.resource.data.status == 'active'
          && isActiveMember(getAfter(teamPath(teamId)).data.organizationId)
          && canManageTeamAfterWrite(teamId, getAfter(teamPath(teamId)).data.organizationId);
        allow update: if validTeamMember(teamId, userId)
          && request.resource.data.joinedAt == resource.data.joinedAt
          && canManageTeam(teamId, get(teamPath(teamId)).data.organizationId);
        allow delete: if canManageTeam(teamId, get(teamPath(teamId)).data.organizationId);
      }
    }

    match /routes/{routeId} {
      allow read: if isActiveMember(resource.data.organizationId);
      allow create: if validRoute(routeId)
        && request.resource.data.status == 'draft'
        && !('latestSubmittedVersionId' in request.resource.data)
        && !('approvedVersionId' in request.resource.data)
        && request.resource.data.createdByUserId == request.auth.uid
        && exists(teamPath(request.resource.data.ownerTeamId))
        && get(teamPath(request.resource.data.ownerTeamId)).data.organizationId
          == request.resource.data.organizationId
        && existsAfter(draftPath(routeId, request.resource.data.currentDraftId))
        && getAfter(draftPath(routeId, request.resource.data.currentDraftId)).data.id
          == request.resource.data.currentDraftId
        && getAfter(draftPath(routeId, request.resource.data.currentDraftId)).data.routeId == routeId
        && canManageTeam(
          request.resource.data.ownerTeamId,
          request.resource.data.organizationId
        );
      allow update: if validRoute(routeId)
        && canManageRoute(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'updatedAt']);
      allow delete: if false;

      match /drafts/{draftId} {
        allow read: if canManageRoute(get(routePath(routeId)).data)
          && get(routePath(routeId)).data.currentDraftId == draftId;
        allow create: if validDraft(routeId, draftId, getAfter(routePath(routeId)).data)
          && !('basedOnVersionId' in request.resource.data)
          && canWriteDraft(routeId, draftId);
        allow update: if validDraft(routeId, draftId, getAfter(routePath(routeId)).data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.routeId == resource.data.routeId
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.ownerTeamId == resource.data.ownerTeamId
          && request.resource.data.get('basedOnVersionId', null)
            == resource.data.get('basedOnVersionId', null)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'content', 'updatedByUserId', 'updatedAt'
          ])
          && canWriteDraft(routeId, draftId);
        allow delete: if false;

        match /stations/{stationId} {
          allow read: if canManageRoute(get(routePath(routeId)).data)
            && get(routePath(routeId)).data.currentDraftId == draftId;
          allow create, update: if validDraftStation(routeId, draftId, stationId)
            && existsAfter(draftPath(routeId, draftId))
            && getAfter(draftPath(routeId, draftId)).data.routeId == routeId
            && canWriteDraft(routeId, draftId);
          allow delete: if canWriteDraft(routeId, draftId);
        }
      }
    }
  }
}
